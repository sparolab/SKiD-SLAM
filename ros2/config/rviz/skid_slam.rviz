            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /jackal1/skid_slam/mapping/loop_closure_constraints
          Value: false
      Enabled: true
      Name: jackal1
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.5
